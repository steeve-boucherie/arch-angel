#!/bin/bash

# Start Steam Big Picture session with proper cleanup and logging
# Based on: https://wiki.archlinux.org/title/Steam#Starting_Big_Picture_Mode_on_login

# Log file for debugging
LOGFILE="/tmp/steam-session.log"
exec > "$LOGFILE" 2>&1

echo "=== Steam session starting at $(date) ==="

# Set up X11 environment
export DISPLAY=:0

# Function to cleanup background processes on exit
cleanup() {
    echo "Cleaning up processes..."
    kill $WM_PID $PIPEWIRE_PID $PIPEWIRE_PULSE_PID $WIREPLUMBER_PID 2>/dev/null
    sleep 1
    kill -9 $WM_PID $PIPEWIRE_PID $PIPEWIRE_PULSE_PID $WIREPLUMBER_PID 2>/dev/null
}

# Set trap to ensure cleanup runs when script exits
trap cleanup EXIT

echo "Starting audio services..."

# Start PipeWire audio
/usr/bin/pipewire &
PIPEWIRE_PID=$!
echo "PipeWire started with PID $PIPEWIRE_PID"

/usr/bin/pipewire-pulse &
PIPEWIRE_PULSE_PID=$!
echo "PipeWire-pulse started with PID $PIPEWIRE_PULSE_PID"

/usr/bin/wireplumber &
WIREPLUMBER_PID=$!
echo "WirePlumber started with PID $WIREPLUMBER_PID"

# Give audio system time to initialize
sleep 2

echo "Configuring X11..."
# Disable screen blanking and power management
xset s off
xset -dpms
xset s noblank

echo "Starting window manager..."
# Start minimal window manager
openbox --config-file /dev/null &
WM_PID=$!
echo "Openbox started with PID $WM_PID"

echo "Start Picom compositor in background"
picom --backend glx &
sleep 2


echo "Starting Steam..."
# Start Steam in Big Picture mode
steam -bigpicture

echo "=== Steam exited at $(date) ==="
